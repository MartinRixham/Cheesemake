#!/bin/bash

name="$(get_executable_name)"
compiler="$(get_compiler)"
defines="$(get_defines)"
includes="-Isrc -Ibuild/include $(get_includes source_dependencies)"
links="-Lbuild/lib $(get_module_links source_dependencies) $(get_links source_dependencies) $(get_static_links source_dependencies | non_empty | map link_statically)"
flags="$(echo "$@" | jq -r .flags | not is_null)"
options="$(echo "$@" | jq -r .options | not is_null)"
args="$(echo "$@" | jq -r .args | not is_null)"

mkdir -p build/tsan/build/bin
copy_all src build/tsan
test ! -d build/lib || copy_all build/lib build/tsan/build
test ! -d build/include || copy_all build/include build/tsan/build

cd build/tsan
verbose $compiler -fsanitize=thread -fno-omit-frame-pointer $flags $defines -o $name $includes $(get_sources src) $links
echo "TSAN_OPTIONS=$options $name $args"
TSAN_OPTIONS="$options" $name $args
